---
import Layout from "./Layout.astro";

export type PricingBracket = {
	label: string;
	price: string;
	note?: string;
};

interface Props {
	title: string;
	description: string;
	serviceName: string;
	tagline: string;
	pricing?: PricingBracket[];
}

const { title, description, serviceName, tagline, pricing } = Astro.props;
---

<Layout title={title} description={description}>
	<!-- Wraps everything on the page (stretched to at least fill .main via
	     min-height: 100% in CSS) so the back button below has a containing
	     block that ends exactly where the footer begins — see the
	     .is-above-footer rule and the script at the bottom for why that
	     matters. -->
	<div class="service-page-wrap">
		<section class="hero">
			<div class="container">
				<h1>{serviceName}</h1>
				<p>{tagline}</p>
			</div>
		</section>

		<section class="container">
			<div class="section-heading">
				<h2>Capabilities</h2>
			</div>
			<div class="prose">
				<slot />
			</div>
		</section>

		{
			pricing && pricing.length > 0 && (
				<section class="container">
					<div class="section-heading">
						<h2>Pricing</h2>
						<p>
							Ballpark ranges for common scopes of work below for "typical" finishes - every renovation is different, so treat these as a
							starting point for budgeting, not a quote.
						</p>
					</div>
					<div class="pricing-list">
						{pricing.map((bracket) => (
							<div class="pricing-row">
								<div class="pricing-row-header">
									<p class="pricing-label">{bracket.label}</p>
									<p class="pricing-price">{bracket.price}</p>
								</div>
								{bracket.note && <p class="pricing-note">{bracket.note}</p>}
							</div>
						))}
					</div>
				</section>
			)
		}

		<section class="container">
			<div class="notice">
				<p>Ready to talk through your project? Let's figure out what it actually needs.</p>
				<a class="btn btn-primary" href="/contact/">Get a Quote</a>
			</div>
		</section>

		<!-- Fixed by default (reachable without scrolling, from anywhere on the
		     page — the whole point, especially on mobile where these pages can
		     run long), but switches to absolute positioning — anchored to
		     .service-page-wrap, right where the footer begins — once the
		     footer is about to enter the viewport, so it comes to rest above
		     the footer instead of floating on top of it. -->
		<a class="service-back-fab" href="/services/">&larr; All Services</a>
	</div>

	<script>
		const fab = document.querySelector<HTMLAnchorElement>(".service-back-fab");
		const footer = document.querySelector(".site-footer");
		if (fab && footer) {
			// Positive bottom rootMargin makes the observed area extend past the
			// real viewport edge, so this fires slightly before the footer is
			// actually visible — enough buffer to swap positioning modes before
			// there's any visible overlap or jump.
			const observer = new IntersectionObserver(
				([entry]) => {
					fab.classList.toggle("is-above-footer", entry.isIntersecting);
				},
				{ rootMargin: "0px 0px 96px 0px" },
			);
			observer.observe(footer);
		}
	</script>
</Layout>
