---
const navLinks = [
	{ href: "/", label: "Home" },
	{ href: "/services/", label: "Services" },
	{ href: "/partners/", label: "Partners" },
	{ href: "/portfolio/", label: "Portfolio" },
	{ href: "/about/", label: "About" },
	{ href: "/contact/", label: "Contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
	<a href="/wemoved" class="annoucement">
		<p>We've moved from PA to TN. Click here for more info. &rarr;</p>
	</a>
	<div class="container header-inner">
		<a class="logo" href="/">Matlack Electric</a>
		<button
			type="button"
			class="nav-toggle"
			aria-expanded="false"
			aria-controls="site-nav"
			aria-label="Toggle navigation"
		>
			<span></span>
		</button>
		<nav class="site-nav" id="site-nav">
			<ul>
				{navLinks.map((link) => (
					<li>
						<a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>
							{link.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
		<!-- Hidden, inert stand-in for the links, always laid out on one line —
		     measured to decide whether the real links fit next to the logo,
		     independent of whichever mode .site-nav is currently showing. -->
		<ul class="nav-measure" aria-hidden="true">
			{navLinks.map((link) => (
				<li>{link.label}</li>
			))}
		</ul>
	</div>
</header>

<script is:inline>
	// is:inline (rather than Astro's default processed/module script) so this
	// runs synchronously the instant the parser reaches it - right after the
	// header markup above, before the browser's next paint. A processed
	// script gets type="module" and is deferred until after the whole
	// document parses, which on a full page load (e.g. clicking the logo)
	// let the header paint once in its default full-nav layout before
	// checkFit() below could run and add .is-compact, flashing the desktop
	// nav row on mobile. is:inline skips Astro's TypeScript handling, so the
	// querySelector generics below are gone - the runtime null checks
	// immediately after already cover the same ground.
	const header = document.querySelector(".site-header");
	const headerInner = document.querySelector(".header-inner");
	const logo = document.querySelector(".logo");
	const toggle = document.querySelector(".nav-toggle");
	const nav = document.querySelector(".site-nav");
	const measure = document.querySelector(".nav-measure");

	if (header && headerInner && logo && toggle && nav && measure) {
		// Collapse the menu and flip the a11y state back to closed.
		const closeNav = () => {
			nav.classList.remove("is-open");
			toggle.setAttribute("aria-expanded", "false");
		};

		// Expand the menu and flip the a11y state to open.
		const openNav = () => {
			nav.classList.add("is-open");
			toggle.setAttribute("aria-expanded", "true");
		};

		// Hamburger button flips between open and closed.
		toggle.addEventListener("click", () => {
			nav.classList.contains("is-open") ? closeNav() : openNav();
		});

		// Any click outside the menu or the toggle button closes it.
		document.addEventListener("click", (event) => {
			if (!nav.classList.contains("is-open")) return;
			const target = event.target;
			if (nav.contains(target) || toggle.contains(target)) return;
			closeNav();
		});

		// Escape closes the menu and returns focus to the toggle button.
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && nav.classList.contains("is-open")) {
				closeNav();
				toggle.focus();
			}
		});

		// Switches between the inline link row and the hamburger + dropdown
		// based on whether the links actually fit next to the logo, not a
		// fixed viewport width — so adding, removing, or renaming a link
		// never needs a breakpoint number revisited to match it. .nav-measure
		// (always laid out on one line, hidden off-screen) gives the natural
		// width the real links would need; MIN_GAP is how much breathing
		// room to keep between the logo and the links even in the tightest
		// case that still counts as "fits" — double of .header-inner's own
		// side padding, so the gap between the two is distinct.
		const checkFit = () => {
			const headerInnerStyle = getComputedStyle(headerInner);
			const minGap = 2*parseFloat(headerInnerStyle.paddingLeft);
			// clientWidth includes .header-inner's own left/right padding,
			// but flex layout positions children within the content box,
			// inside that padding — without subtracting it, "available"
			// came out ~40px too generous, so the switch to compact fired
			// only once the links were already jammed against the logo.
			const horizontalPadding = parseFloat(headerInnerStyle.paddingLeft) + parseFloat(headerInnerStyle.paddingRight);
			const available = headerInner.clientWidth - horizontalPadding - logo.getBoundingClientRect().width - minGap;
			const fits = measure.scrollWidth <= available;
			header.classList.toggle("is-compact", !fits);
			// Switching to the inline row clears any stale open state left
			// over from the dropdown.
			if (fits) closeNav();
		};
		checkFit();
		window.addEventListener("resize", checkFit);
	}
</script>
