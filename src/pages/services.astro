---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Services | Matlack Electric"
  description="Renovation wiring, low-voltage and networking, custom lighting design, Lutron smart control, EV chargers, generators, and battery backup — Matlack Electric's residential electrical services."
>
  <section class="hero">
    <div class="container">
      <h1>Our Services</h1>
      <p>Electrical expertise for renovations, from rough-in to final trim.</p>
    </div>
  </section>

  <section class="container">
    <div class="grid">
      <div class="card">
        <h3>Renovation &amp; Remodel Wiring</h3>
        <p>Whole-home rewiring, panel upgrades, and circuits built for renovation-scale projects.</p>
      </div>
      <div class="card">
        <h3>Low-Voltage, Data &amp; Network</h3>
        <p>Structured wiring, home networking, and whole-house WiFi design.</p>
      </div>
      <div class="card">
        <h3>Custom Lighting Design</h3>
        <p>Consultation and installation for lighting that elevates every room.</p>
      </div>
      <div class="card">
        <h3>Lutron Caseta &amp; RadioRa</h3>
        <p>Smart lighting and shade control integrated into your renovation.</p>
      </div>
      <div class="card">
        <h3>EV Charger Installation</h3>
        <p>Level 2 charging built in from the start or added after the fact.</p>
      </div>
      <div class="card">
        <h3>Standby Generators</h3>
        <p>Whole-home backup power for peace of mind, whatever the weather.</p>
      </div>
      <div class="card">
        <h3>Battery Backup Systems</h3>
        <p>Modern energy resilience for the connected home.</p>
      </div>
      <div class="card">
        <h3>Renovation Partnership</h3>
        <p>Coordinating closely with your designer, architect, or general contractor from rough-in to final trim.</p>
      </div>
    </div>
  </section>

  <section class="container">
    <div class="notice">
      <p>Don't see what you're looking for? Reach out and we'll let you know if we can help.</p>
      <a class="btn btn-primary" href="/contact/">Contact Us</a>
    </div>
  </section>
</Layout>
