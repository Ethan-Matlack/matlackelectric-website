---
import ServiceLayout, { type PricingBracket } from "../../layouts/ServiceLayout.astro";

const pricing: PricingBracket[] = [
	{
		label: "Caseta retrofit (per device)",
		price: "Approx. $100",
		note: "Simple swap of existing switches and dimmers for smart devices (or adding wireless remote/keypads). No new wiring needed.",
	},
	{
		label: "RadioRA 3 whole-home system",
		price: "Starting at $8,000",
		note: "The approximate additional cost for a whole-home RadioRA 3 system on top of a basic installation with standard switches and dimmers.",
	},
];
---

<ServiceLayout
	title="Lutron Controls | Matlack Electric"
	description="Smart lighting and shade control from Lutron - RadioRA 3 for whole-home systems, Caseta for budget and retrofit-friendly upgrades. We design the keypads and scenes around how you actually use each room, not just switch everything over to an app."
	serviceName="Lutron Controls"
	tagline="Smart lighting and shade control from Lutron - RadioRA 3 for whole-home systems, Caseta for budget and retrofit-friendly upgrades. We design the keypads and scenes around how you actually use each room, not just switch everything over to an app."
	pricing={pricing}
>
	<ul>
		<li>Certified installation of both Lutron Caseta and RadioRA 2/3.</li>
		<li>Caseta for budget and retrofit-friendly projects - no need to open every wall.</li>
		<li>RadioRA 3 for whole-home lighting and shade control on larger renovations.</li>
		<li>Keypad and scene programming (All On/Off, Entertain, Relax, and more) tailored to how you actually live.</li>
		<li>Motorized shade and Sonos audio integration alongside lighting control.</li>
	</ul>
</ServiceLayout>
