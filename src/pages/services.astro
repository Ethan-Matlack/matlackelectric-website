---
import Layout from "../layouts/Layout.astro";
import CardLink from "../components/CardLink.astro";
---

<Layout
  title="Services | Matlack Electric"
  description="Renovation wiring, low-voltage and networking, custom lighting design, Lutron smart control, EV chargers, generators, and battery backup — Matlack Electric's residential electrical services."
>
  <section class="hero">
    <div class="container">
      <h1>Our Services</h1>
      <p>Electrical expertise for your entire project. No need to hire multiple contractors for electrical, data, A/V, controls, security, etc. We own the entire process from start to finish, ensuring quality and seamless integration.</p>
    </div>
  </section>

  <div class="container">
    <div class="grid">
      <CardLink href="/services/renovations/">
        <h3>Renovations</h3>
        <p>Rewiring and panel upgrades for small projects all the way up to full-gut renovations.</p>
      </CardLink>
      <CardLink href="/services/new-builds/">
        <h3>New Builds</h3>
        <p>Full electrical and telecom installation for residential new construction projects.</p>
      </CardLink>
      <CardLink href="/services/lighting/">
        <h3>Custom Lighting</h3>
        <p>If you can dream it, we can design and install it. We have in-house lighting design capabilities.</p>
      </CardLink>
      <CardLink href="/services/controls/">
        <h3>Lutron Controls</h3>
        <p>Smart controls from the industry-leader Lutron. Caseta and RadioRa 2/3 certified installer.</p>
      </CardLink>
      <CardLink href="/services/shades/">
        <h3>Lutron Shades</h3>
        <p>Motorized shades and drapery from the industry-leader Lutron.</p>
      </CardLink>
      <CardLink href="/services/networking/">
        <h3>Low-Voltage, Data &amp; Network</h3>
        <p>Structured wiring, home networking, whole-house WiFi design, security cameras, and more.</p>
      </CardLink>
      <CardLink href="/services/audiovisual/">
        <h3>Audio/Visual</h3>
        <p>Integrated audio and visual solutions for your home or business.</p>
      </CardLink>
      <CardLink href="/services/ev-charging/">
        <h3>EV Charging</h3>
        <p>EV charger installation - including load management solutions - from a Tesla Certified installer.</p>
      </CardLink>
      <CardLink href="/services/backup-power/">
        <h3>Backup Power Solutions</h3>
        <p>Generators, battery backup systems, solar, and load management solutions.</p>
      </CardLink>
      <CardLink href="/services/commercial/">
        <h3>Commercial</h3>
        <p>Specialized electrical solutions for light-commercial properties (restaurants, small offices, etc.).</p>
      </CardLink>
    </div>
  </div>

  <div class="container">
    <div class="notice">
      <p>Don't see what you're looking for? Reach out and we'll let you know if we can help.</p>
      <a class="btn btn-primary" href="/contact/">Contact Us</a>
    </div>
  </div>
</Layout>
