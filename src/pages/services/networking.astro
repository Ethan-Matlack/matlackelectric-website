---
import ServiceLayout, { type PricingBracket } from "../../layouts/ServiceLayout.astro";

// PLACEHOLDER PRICING — rough guesses, not real numbers. Replace before
// this page goes live.
const pricing: PricingBracket[] = [
	{
		label: "WiFi coverage assessment + access point install",
		price: "$800 – $1,500",
		note: "Fixing dead zones in an existing home.",
	},
	{
		label: "Security camera system (per camera)",
		price: "$400 – $700",
		note: "Wired camera, mounting, and network integration.",
	},
	{
		label: "Full network build-out",
		price: "$3,000 – $6,000",
		note: "Rack, switches, and access points for whole-home coverage.",
	},
];
---

<ServiceLayout
	title="Low-Voltage, Data & Network | Matlack Electric"
	description="Structured wiring, Ubiquiti UniFi network design, and security camera systems — the low-voltage backbone for a home that actually works the way you expect it to."
	serviceName="Low-Voltage, Data &amp; Network"
	tagline="Structured wiring, whole-house WiFi design, and security camera systems — the low-voltage backbone for a home that actually works the way you expect it to, wired in during your renovation instead of patched in later."
	pricing={pricing}
>
	<ul>
		<li>Structured cabling (Cat6/Cat6a) run to the rooms that need it, not just wherever's convenient.</li>
		<li>Ubiquiti UniFi network design — access points, switches, and a router that covers the whole home.</li>
		<li>Wired security camera systems, integrated with your network from the start.</li>
		<li>Wired drops for streaming, gaming, and home office setups that WiFi alone can't handle.</li>
		<li>Network racks and patch panels sized and mounted cleanly, not an afterthought closet.</li>
	</ul>
</ServiceLayout>
