---
import ServiceLayout, { type PricingBracket } from "../../layouts/ServiceLayout.astro";

const pricing: PricingBracket[] = [
	{
		label: "Standby generator (whole-home)",
		price: "$12,000 – $18,000",
		note: "Generac generator, transfer switch, and install for an average-size home.",
	},
	{
		label: "Battery backup solutions",
		price: "Starting at $10,000",
		note: "Standalone or solar-integrated, sized to cover essential circuits during an outage.",
	},
	{
		label: "Transfer switch",
		price: "$1,000 – $2,500",
		note: "Have a portable generator? We can install a transfer switch to make it plug-and-play while maintaining code compliance and safety.",
	},
];
---

<ServiceLayout
	title="Backup Power Solutions | Matlack Electric"
	description="Generators, battery backup, and solar integration for whole-home resilience — sized to your actual usage and installed to keep your warranty intact."
	serviceName="Backup Power Solutions"
	tagline="Generators, battery backup, and solar integration for whole-home resilience, whatever the grid does. We size the system to your actual usage, not the biggest box we can sell you, and everything is installed to keep your manufacturer's warranty intact."
	pricing={pricing}
>
	<ul>
		<li>Generac certified installer for air-cooled standby generators.</li>
		<li>Battery backup systems, standalone or integrated with solar.</li>
		<li>Automatic transfer switches and critical-loads panels for a seamless outage response.</li>
		<li>Load calculations and load-management devices sized to your home's real usage.</li>
		<li>Permitting, inspection, and utility interconnection coordination handled start to finish.</li>
	</ul>
</ServiceLayout>
