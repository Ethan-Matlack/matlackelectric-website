---
import ServiceLayout, { type PricingBracket } from "../../layouts/ServiceLayout.astro";

const pricing: PricingBracket[] = [
	{
		label: "WiFi coverage assessment + access point install",
		price: "$800 – $1,500",
		note: "Have dead zones in your home? Your ISP's router typically isn't enough to cover a whole home. We'll assess your home's layout and install access points for whole-home coverage.",
	},
	{
		label: "Security camera system",
		price: "~$500 + $250/camera",
		note: "Includes installation of an NVR and cameras, plus configuration of the system. No subscription fees or cloud dependencies. Assumes reasonable access to the areas where cameras are installed. Price varies based on number of cameras and complexity of installation.",
	},
	{
		label: "Full network build-out",
		price: "Starting at $2,000",
		note: "Have a new build or major renovation? We can design and install a full structured wiring and networking system, including a network rack, patch panel, access points, and more. Price varies based on size of home and complexity of installation.",
	},
];
---

<ServiceLayout
	title="Low-Voltage, Data & Network | Matlack Electric"
	description="Structured wiring, Ubiquiti UniFi network design, and security camera systems — the low-voltage backbone for a home that actually works the way you expect it to."
	serviceName="Low-Voltage, Data &amp; Network"
	tagline="Structured wiring, whole-house WiFi design, and security camera systems - the low-voltage backbone for a home that actually works the way you expect it to, planned for and wired from the beginning, not as an afterthought once the walls are closed."
	pricing={pricing}
>
	<ul>
		<li>Structured cabling (Cat6/Cat6a) run to the rooms and walls that need it, not just wherever's convenient.</li>
		<li>Ubiquiti network design. We simulate the WiFi coverage during design to ensure optimal performance.</li>
		<li>Ubiquiti UniFi access point installation and configuration for whole-home coverage.</li>
		<li>Wired security camera systems with absolutely no subscription fees or cloud dependencies.</li>
		<li>Network racks and patch panels sized with room to spare and labeled clearly for future maintenance.</li>
	</ul>
</ServiceLayout>
