---
import CaseStudyLayout, { type Testimonial } from "../../layouts/CaseStudyLayout.astro";
import { Image } from "astro:assets";
import { portfolioProjects } from "../../data/portfolio";
// PLACE LINKS TO IMAGES BELOW -- The placeholder image line can be removed once you have real images to use.
import placeholder640x400 from "../../images/placeholder_640x400.svg";

// SET SLUG BELOW to match this file's name and its entry in portfolio.ts -
// tags come from there rather than being retyped here, so this page can't
// drift out of sync with what the Portfolio index and its filter chips
// show for this project.
const { tags } = portfolioProjects.find((p) => p.slug === "SLUG-GOES-HERE")!;

const testimonial: Testimonial = {
	quote: "A quote from the client or builder about how great we are! :)",
	author: "CLIENT NAME",
	role: "CLIENT ROLE"
};
---

<!-- Description is for the meta tag and the tile's blurb on the portfolio page. Tagline is for the hero section within this page. -->
<!-- Comment out or delete the testimonial prop (and the array above) if this case study doesn't have a quote to use. -->
<CaseStudyLayout
	title="PROJECT NAME | Matlack Electric"
	description="PROJECT DESCRIPTION"
	projectName="PROJECT NAME"
	tagline="PROJECT TAGLINE"
	tags={tags}
	testimonial={testimonial}
>
	<p>
		OPENING REMARK: lorem ipsum dolor sit amet consectetur adipiscing elit
		sit amet voluptas eligendi et elit fugiat id omnis est minim aut
		voluptas quod cupiditate magna assumenda nostrud est eos et nulla in
		facere cupiditate culpa fuga accusamus nostrud mollitia ipsum ut
	</p>

	<div class="case-study-split">
		<Image src={placeholder640x400} alt="Project Image" />
		<div>
			<h3>TITLE 1</h3>
			<p>
				lorem ipsum dolor sit amet consectetur adipiscing elit eu fugiat
				sed excepteur et excepteur assumenda aute fuga occaecat et illum
				non qui dolorem est occaecat
			</p>
		</div>
	</div>

	<div class="case-study-split reverse">
		<Image src={placeholder640x400} alt="Project Image" />
		<div>
			<h3>TITLE 2</h3>
			<p>
				lorem ipsum dolor sit amet consectetur adipiscing elit eu fugiat
				sed excepteur et excepteur assumenda aute fuga occaecat et illum
				non qui dolorem est occaecat
			</p>
		</div>
	</div>

	<figure class="case-study-image">
		<Image src={placeholder640x400} alt="Project Image" />
		<figcaption>
			IMAGE CAPTION: lorem ipsum dolor sit amet consectetur adipiscing
			elit molestias sit officia soluta dolor tempore blanditiis velit
		</figcaption>
	</figure>

	<p>
		CLOSING REMARK: lorem ipsum dolor sit amet consectetur adipiscing elit
		eu fugiat sed excepteur et excepteur assumenda aute fuga occaecat et
		illum non qui dolorem est occaecat in mollitia assumenda ut expedita
	</p>
</CaseStudyLayout>
