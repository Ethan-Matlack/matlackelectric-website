---
import CaseStudyLayout, {type Testimonial } from "../../layouts/CaseStudyLayout.astro";
import { Image } from "astro:assets";
// PLACE LINKS TO IMAGES BELOW -- The placeholder image line can be removed once you have real images to use.
import placeholder640x400 from "../../images/placeholder_640x400.svg";

const testimonial: Testimonial = {
	quote: "A quote from the client or builder about how great we are! :)",
	author: "CLIENT NAME",
	role: "CLIENT ROLE"
};
---

<!-- Description is for the tile on the portfolio page. Tagline is for the hero section within the case study. -->
<!-- Comment out or delete the testimonial prop if you don't want to display it. -->
<CaseStudyLayout
	title="The Citrone Addition | Matlack Electric"
	description="A kitchen and dining addition featuring custom beam uplighting, cabinet lighting, and smart home integration."
	projectName="The Citrone Addition"
	tagline="A kitchen & dining addition built around layered lighting and whole-room smart control."
	tags={["Kitchen", "Addition"]}
	testimonial={testimonial}
>
	<p>
		This project added a full kitchen and dining space onto the back of the home, and the brief from day one was
		lighting-first: the exposed beams overhead needed to be a feature, not just something to work around, and the
		whole space needed to dim and scene together instead of being switched room by room.
	</p>

	<div class="case-study-split">
		<Image src={placeholder640x400} alt="Project Image" />
		<div>
			<h3>Beam Uplighting</h3>
			<p>
				Concealed fixtures run the length of each exposed beam, washing light upward instead of down — the beams
				read as a design feature after dark instead of disappearing into shadow.
			</p>
		</div>
	</div>

	<div class="case-study-split reverse">
		<Image src={placeholder640x400} alt="Project Image" />
		<div>
			<h3>Cabinet Lighting</h3>
			<p>
				Undercabinet and toe-kick lighting throughout the kitchen, all on the same dimming system as the beams —
				task lighting where it's needed without a separate switch plate for every zone.
			</p>
		</div>
	</div>

	<figure class="case-study-image">
		<Image src={placeholder640x400} alt="Project Image" />
		<figcaption>The addition at night, beams, cabinets, and general lighting all on one Lutron scene.</figcaption>
	</figure>

	<p>
		Everything in the addition — beams, cabinets, general lighting — is tied into a single Lutron RadioRA 3 system,
		so the whole space moves between "cooking," "dinner," and "off" with one keypad press instead of six switches.
	</p>
</CaseStudyLayout>
