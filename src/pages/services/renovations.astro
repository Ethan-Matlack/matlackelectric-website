---
import ServiceLayout, { type PricingBracket } from "../../layouts/ServiceLayout.astro";

const pricing: PricingBracket[] = [
	{
		label: "Kitchen Rewire",
		price: "$6,000 - $10,000",
		note: "New circuits, lighting, switches, and outlets for a full kitchen remodel or addition.",
	},
	{
		label: "Whole-home Rewire",
		price: "Starting at $20,000",
		note: "Full gut renovations - includes panel replacement. Scope varies significantly with home size and access.",
	},
	{
		label: "Panel/Service Upgrade",
		price: "$2,000 – $7,000",
		note: "Common for older homes taking on more electrical load (may be required for EV charging or switching to electric appliances.)",
	},
];
---

<ServiceLayout
	title="Renovations & Remodels | Matlack Electric"
	description="Whole-home rewiring, panel upgrades, and circuits built for renovation-scale projects — coordinated with your renovation's timeline, not fought against it."
	serviceName="Renovations & Remodels"
	tagline="Whole-home rewiring, panel upgrades, and circuits built for renovation-scale projects."
	pricing={pricing}
>
	<ul>
		<li>Full or partial home rewiring for gut renovations and additions.</li>
		<li>Electrical panel upgrades and service capacity increases.</li>
		<li>Lighting consultation and design services as part of the renovation process.</li>
		<li>Custom solutions tailored to your specific needs and preferences - not shoe-horned in.</li>
		<li>Permitting and inspection process handled start to finish.</li>
		<li>Close coordination with designers, architects, and general contractors throughout.</li>
	</ul>
</ServiceLayout>
