---
import ServiceLayout, { type PricingBracket } from "../../layouts/ServiceLayout.astro";

// PLACEHOLDER PRICING — not real numbers. Replace before this page goes
// live; "$X,XXX" is deliberate so it can't be mistaken for a real price.
const pricing: PricingBracket[] = [
	{
		label: "Caseta retrofit, per room",
		price: "Starting at $XXX",
		note: "Smart switches/dimmers, no new wiring needed.",
	},
	{
		label: "RadioRA 3 whole-home system",
		price: "Starting at $X,XXX",
		note: "Full keypad and dimmer system for a renovation-scale project.",
	},
	{
		label: "Motorized shade integration",
		price: "Starting at $X,XXX",
		note: "Per room, shades and controls included.",
	},
];
---

<ServiceLayout
	title="Lutron Caseta & RadioRA 3 | Matlack Electric"
	description="Certified Lutron Caseta and RadioRA 3 installation — smart lighting and shade control integrated into your renovation, sized to fit the project."
	serviceName="Lutron Caseta &amp; RadioRA 3"
	tagline="Smart lighting and shade control integrated into your renovation."
	pricing={pricing}
>
	<ul>
		<li>Certified installation of both Lutron Caseta and RadioRA 3.</li>
		<li>Caseta for retrofit-friendly projects — no need to open every wall.</li>
		<li>RadioRA 3 for whole-home lighting and shade control on larger renovations.</li>
		<li>Keypad and scene programming (All On/Off, Entertain, Relax, and more) tailored to how you actually live.</li>
		<li>Motorized shade integration alongside lighting control.</li>
		<li>App, voice assistant, and smart home platform integration.</li>
	</ul>
</ServiceLayout>
