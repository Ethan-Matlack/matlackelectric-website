---
import Layout from "../layouts/Layout.astro";
import CardLink from "../components/CardLink.astro";
---

<Layout
  title="Portfolio | Matlack Electric"
  description="Showcase of Matlack Electric's residential electrical work, including renovation wiring, custom lighting, smart home control, EV charging, and backup power installations."
>
  <section class="hero">
    <div class="container">
      <h1>Our Portfolio</h1>
      <p>Explore our recent residential electrical projects.</p>
    </div>
  </section>

  <section class="container">
    <div class="section-heading">
      <h2>Recent Projects</h2>
      <p>Take a look at some of our recent work in residential electrical installations.</p>
    </div>
    <div class="grid">
      <CardLink href="/portfolio/citrone-addition/">
        <h3>The Citrone Addition</h3>
        <p>A stunning kitchen & dining addition with custom beam uplighting, cabinet lighting, and smart home integration.</p>
      </CardLink>
      <CardLink href="/portfolio/REPLACE_THIS/">
        <h3>Project 2</h3>
        <p>A description of Project 2.</p>
      </CardLink>
      <CardLink href="/portfolio/REPLACE_THIS/">
        <h3>Project 3</h3>
        <p>A description of Project 3.</p>
      </CardLink>
    </div>
  </section>
</Layout>
