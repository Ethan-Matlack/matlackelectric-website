---
import ServiceLayout, { type PricingBracket } from "../../layouts/ServiceLayout.astro";

const pricing: PricingBracket[] = [
	{
		label: "Level 2 charger",
		price: "$1,000 – $2,000",
		note: "Install of a Tesla Wall Connector or similar Level 2 charger for any major EV brand. Price reflects a typical garage installation with a 240V circuit run from a nearby panel to the charger location. Price varies based on distance from panel, wall type, and complexity of installation.",
	},
	{
		label: "Commercial chargers",
		price: "Contact for quote",
		note: "Have a small business or commercial property? We can install commercial EV chargers for your employees or customers. Price varies based on number of chargers, distance from panel, and complexity of installation.",
	},
];
---

<ServiceLayout
	title="EV Charging | Matlack Electric"
	description="EV charger installation for renovations and existing homes, including load management for multi-vehicle households, from a Tesla Certified installer."
	serviceName="EV Charging"
	tagline="EV charger installation for renovations and existing homes, including load management for multi-vehicle households — from a Tesla Certified installer who sources Wall Connectors directly and installs to Tesla's own standards."
	pricing={pricing}
>
	<ul>
		<li>Tesla Certified Installer - we source Wall Connectors directly and install to Tesla's standards.</li>
		<li>Level 2 (240V/208V) charger circuit installation for any major EV brand - Tesla, Rivian, Ford, and more.</li>
		<li>Panel capacity evaluation, including load calculations and panel upgrades where needed.</li>
		<li>Load management systems for homes or businesses charging multiple EVs on shared panel capacity.</li>
	</ul>
</ServiceLayout>
