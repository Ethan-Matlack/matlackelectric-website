---
// Fixed by default (reachable without scrolling, from anywhere on the
// page — long detail pages, especially on mobile), but switches to
// absolute positioning once the footer is about to enter the viewport —
// see .detail-back-fab.is-above-footer in global.css and the script below.
// Must be rendered inside a `.detail-page-wrap` ancestor (that's the
// containing block the "above footer" state anchors to).
interface Props {
	href: string;
	label: string;
}

const { href, label } = Astro.props;
---

<a class="detail-back-fab" href={href}>&larr; {label}</a>

<script>
	const fab = document.querySelector<HTMLAnchorElement>(".detail-back-fab");
	const footer = document.querySelector(".site-footer");
	if (fab && footer) {
		// No rootMargin buffer, deliberately: fixed (viewport-relative) and
		// .is-above-footer (absolute, anchored to .detail-page-wrap) only
		// land on the same on-screen spot at one precise scroll position —
		// the instant the footer's top edge reaches the viewport's bottom
		// edge. Triggering any earlier (a positive rootMargin, tried first)
		// swaps to the absolute position before the page has scrolled that
		// far, and since that position is still below the fold at that
		// moment, the button visibly jumps off-screen before scrolling back
		// into view over the buffer distance. Firing exactly at the crossing
		// point is what makes the two modes hand off without a jump.
		const observer = new IntersectionObserver(
			([entry]) => {
				fab.classList.toggle("is-above-footer", entry.isIntersecting);
			},
			{ rootMargin: "0px" },
		);
		observer.observe(footer);
	}
</script>
